{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Build and debug active file",
      "type": "cppdbg",
      "request": "launch",
      "program": "/home/leo/CC_Exp/build/examples/PowerTCP/ns3.39-${fileBasenameNoExtension}-debug",
      "args": [],
      "stopAtEntry": false,
      "cwd": "/home/leo/CC_Exp",
      "environment": [],
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "NS3: build",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}





