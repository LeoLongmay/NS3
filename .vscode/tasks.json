{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "NS3: build",
      "type": "shell",
      "command": "bash",
      "args": ["-c", "cd /home/master01/CC_Exp && ./ns3 build"],
      "options": {
        "cwd": "/home/master01/CC_Exp"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}




